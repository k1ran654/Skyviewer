<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SKYVIEWER - {{ player.username if player else "Search" }}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    <script defer src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="glass-theme">
    <div class="app-container">
        <nav class="sidebar retractable">
            <div class="sidebar-header">
                <h1 class="logo">SKYVIEWER</h1>
            </div>

            <div class="search-box">
                <form action="/stats" method="POST">
                    <input type="text" name="username" placeholder="Search Player..." value="{{ player.username if player else '' }}">
                </form>
            </div>

            {% if player %}
            <div class="nav-groups">
                <div class="nav-group">
                    <div class="group-title" onclick="toggleGroup('inventories')">
                        <i data-lucide="folder"></i> Inventories
                    </div>
                    <ul id="inventories" class="nav-list">
                        <li onclick="showSection('inventory')">inventory</li>
                        <li onclick="showSection('storage')">storage</li>
                        <li onclick="showSection('sacks')">sacks</li>
                        <li onclick="showSection('accessories')">accessories</li>
                        <li onclick="showSection('pets')">pets</li>
                        <li onclick="showSection('museum')">museum</li>
                    </ul>
                </div>

                <div class="nav-group">
                    <div class="group-title" onclick="toggleGroup('skills')">
                        <i data-lucide="folder"></i> Skills
                    </div>
                    <ul id="skills" class="nav-list">
                        <li onclick="showSection('skills-main')">skills</li>
                        <li onclick="showSection('dungeons')">dungeons</li>
                        <li onclick="showSection('slayers')">slayers</li>
                    </ul>
                </div>

                <div class="nav-group">
                    <div class="group-title" onclick="toggleGroup('collections')">
                        <i data-lucide="folder"></i> Collections
                    </div>
                    <ul id="collections" class="nav-list">
                        <li onclick="showSection('collections-main')">collections</li>
                        <li onclick="showSection('bestiary')">bestiary</li>
                        <li onclick="showSection('minions')">minions</li>
                    </ul>
                </div>

                <div class="nav-group">
                    <div class="group-title" onclick="toggleGroup('islands')">
                        <i data-lucide="folder"></i> Islands
                    </div>
                    <ul id="islands" class="nav-list">
                        <li onclick="showSection('crimson_isle')">crimson isle</li>
                        <li onclick="showSection('rift')">rift</li>
                        <li onclick="showSection('garden')">garden</li>
                        <li onclick="showSection('ch_mines')">ch mines</li>
                        <li onclick="showSection('galatea')">galatea</li>
                    </ul>
                </div>

                <div class="nav-group">
                    <div class="group-title" onclick="toggleGroup('misc')">
                        <i data-lucide="folder"></i> System
                    </div>
                    <ul id="misc" class="nav-list">
                        <li onclick="showSection('debug')">API Debug</li>
                    </ul>
                </div>
            </div>

            <div class="sidebar-footer">
                <div class="sb-level">SB Level: <span>{{ player.sb_level if player.sb_level else 'N/A' }}</span></div>
            </div>
            {% endif %}
        </nav>

        <main class="viewport">
            {% if player %}
            <div class="player-column" id="player-model-col">
                <div class="player-model-container">
                    <img src="https://mc-heads.net/body/{{ player.username }}" alt="Player Body" class="player-body">
                    <div class="armor-display">
                        </div>
                </div>
            </div>

            <div class="data-column">
                <div id="content-display">
                    
                    <div id="inventory" class="data-section" style="display: block;">
                        <h2>Inventory</h2>
                        <div class="inventory-grid">
                            {% for item in inventories.inventory %}
                                <div class="inventory-slot" title="{{ item['name'] if item else 'Empty' }}">
                                    {% if item %}
                                        <img src="{{ url_for('static', filename='items/' + item['id']|lower + '.png') }}" 
                                            alt="{{ item['name'] }}" 
                                            class="item-texture"
                                            onerror="this.style.display='none';">
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div id="storage" class="data-section" style="display: none;">
                        <h2>Storage (Ender Chest)</h2>
                        <div class="inventory-grid">
                            {% for item in inventories.storage %}
                                <div class="inventory-slot" title="{{ item['name'] if item else 'Empty' }}">
                                    {% if item %}
                                        <img src="{{ url_for('static', filename='items/' + item['id']|lower + '.png') }}" 
                                            alt="{{ item['name'] }}" 
                                            class="item-texture"
                                            onerror="this.style.display='none';">
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div id="sacks" class="data-section" style="display: none;">
                        <h2>Sacks</h2>
                        <div class="inventory-grid">
                            {% for item in inventories.sacks %}
                                <div class="inventory-slot" title="{{ item['name'] if item else 'Empty'}}">
                                    {%if item %}
                                        <img src="{{ url_for('static', filename='items/' + item['id']|lower + '.png') }}" 
                                            alt="{{ item['name'] }}" 
                                            class="item-texture"
                                            onerror="this.style.display='none';">
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div id="pets" class="data-section" style="display: none;">
                        <h2>Pets</h2>
                        <div class="inventory-grid">
                            {% for item in inventories.pets %}
                                <div class="inventory-slot" title="{{ item['name'] of item else 'Empty' }}">
                                    {%if item %}
                                        <img src="{{ url_for('static', filename='items/ + item['id']|lower + '.png') }}"
                                            alt="{{ item['name'] }}"
                                            class="item-texture"
                                            onerror="this.style.display='none';">
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>



                    <div id="accessories" class="data-section" style="display: none;">
                        <h2>Accessory Bag</h2>
                        <div class="inventory-grid">
                            {% for item in inventories.accessories %}
                                <div class="inventory-slot" title="{{ item['name'] if item else 'Empty' }}">
                                    {% if item %}
                                        <img src="{{ url_for('static', filename='items/' + item['id']|lower + '.png') }}" 
                                            alt="{{ item['name'] }}" 
                                            class="item-texture"
                                            onerror="this.style.display='none';">
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div id="skills-main" class="data-section" style="display: none;">
                        <h2>Skills</h2>
                        <div class="skills-container">
                            {% for name, skill_data in skills.items() %}
                                {% set level_info = skill_data.get('level', {}) %}
                                <div class="skill-row">
                                    <span class="skill-name">{{ name|capitalize }}</span>
                                    
                                    <div class="progress-bar-container" 
                                        {% if name == 'mining' %} 
                                        onclick="toggleHotm()" style="cursor: pointer;" title="Click to view Heart of the Mountain"
                                        {% elif name == 'combat' %} 
                                        onclick="toggleCombat()" style="cursor: pointer;" title="Click to view Dungeons & Slayers"
                                        {% endif %}>
                                        
                                        <div class="progress-bar-fill" style="width: {{ level_info.get('progress', 0) }}%;"></div>
                                    </div>
                                    
                                    <span class="skill-level">Lvl {{ level_info.get('level', 0) }}</span>
                                </div>
                                
                                {% if name == 'mining' %}
                                    <div id="hotm-dropdown" style="display: none; margin: 5px 0 15px 0; padding: 12px; background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px;">
                                        <h3 style="margin: 0 0 10px 0; font-size: 1.1em; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 5px;">Heart of the Mountain</h3>
                                        
                                        {% if skill_data.get('hotm') %}
                                            <div style="display: flex; justify-content: space-between; font-size: 0.85em;">
                                                <span><strong>HotM XP:</strong> {{ "{:,}".format(skill_data['hotm'].get('tier', 0)|int) }}</span>
                                                <span style="color: #2bd59d;"><strong>Mithril:</strong> {{ "{:,}".format(skill_data['hotm'].get('mithril_powder', 0)|int) }}</span>
                                                <span style="color: #d52b90;"><strong>Gemstone:</strong> {{ "{:,}".format(skill_data['hotm'].get('gemstone_powder', 0)|int) }}</span>
                                                <span style="color: #a1e2e8;"><strong>Glacite:</strong> {{ "{:,}".format(skill_data['hotm'].get('glacite_powder', 0)|int) }}</span>
                                            </div>
                                        {% else %}
                                            <div style="font-size: 0.85em; color: #aaaaaa;">No HotM stats to show!</div>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                {% if name == 'combat' %}
                                    <div id="combat-dropdown" style="display: none; margin: 5px 0 15px 0; padding: 15px; background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px;">
                                        
                                        {% if skill_data.get('dungeons') %}
                                            <h3 style="margin: 0 0 10px 0; font-size: 1.1em; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 5px;">Dungeons</h3>
                                            
                                            <div style="display: flex; justify-content: space-between; font-size: 0.85em; margin-bottom: 20px;">
                                                {% set cata = skill_data.get('dungeons', {}).get('catacombs', {}) %}
                                                <span><strong>Catacombs Lvl:</strong> {{ cata.get('level', 0) }}</span>
                                                <span style="color: #ff5555;"><strong>Cata XP:</strong> {{ "{:,}".format(cata.get('total_xp', 0)|int) }}</span>
                                                <span style="color: #ffff55;"><strong>Secrets Found:</strong> {{ "{:,}".format(skill_data.get('secrets_found', 0)|int) }}</span>
                                            </div>
                                        {% endif %}

                                        {% if skill_data.get('slayers') %}
                                            <h3 style="margin: 0 0 10px 0; font-size: 1.1em; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 5px;">Slayers</h3>
                                            
                                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                                                {% for boss_name, boss_data in skill_data.get('slayers', {}).items() %}
                                                    <div style="background: rgba(0,0,0,0.3); padding: 10px; border-radius: 4px;">
                                                        <h4 style="margin: 0 0 5px 0; color: #ff5555;">{{ boss_name }} <span style="color: white; font-size: 0.8em; font-weight: normal;">(Lvl {{ boss_data.get('level_data', {}).get('level', 0) }})</span></h4>
                                                        
                                                        <p style="font-size: 0.8em; margin: 2px 0;"><strong>XP:</strong> {{ "{:,}".format(boss_data.get('level_data', {}).get('total_xp', 0)|int) }}</p>
                                                        
                                                        {% if boss_data.get('rng_drop') and boss_data.get('rng_drop') != 'None Selected' %}
                                                            <p style="font-size: 0.8em; color: #d52b90; margin: 2px 0;"><strong>RNG:</strong> {{ boss_data.get('rng_drop') }} ({{ "{:,}".format(boss_data.get('rng_xp', 0)|int) }})</p>
                                                        {% endif %}
                                                        
                                                        <div style="margin-top: 8px; font-size: 0.75em; color: #aaaaaa; display: flex; flex-wrap: wrap; gap: 6px;">
                                                            <span>T1: {{ "{:,}".format(boss_data.get('kills', {}).get('tier_1', 0)|int) }}</span> |
                                                            <span>T2: {{ "{:,}".format(boss_data.get('kills', {}).get('tier_2', 0)|int) }}</span> |
                                                            <span>T3: {{ "{:,}".format(boss_data.get('kills', {}).get('tier_3', 0)|int) }}</span> |
                                                            <span>T4: {{ "{:,}".format(boss_data.get('kills', {}).get('tier_4', 0)|int) }}</span>
                                                            {% if boss_data.get('kills', {}).get('tier_5', 0) > 0 %}
                                                                | <span style="color: #aa00aa;">T5: {{ "{:,}".format(boss_data.get('kills', {}).get('tier_5', 0)|int) }}</span>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}
                                
                            {% endfor %}
                        </div>
                    </div>
                    <div id="dungeons" class="data-section" style="display: none;">
                        <h2>Dungeons</h2>
                        <div class="stat-card">
                            {% set cata = skills.get('combat', {}).get('dungeons', {}).get('catacombs', {}) %}
                            <h3>Catacombs</h3>
                            <p>Lvl {{ cata.get('level', 0) }}</p>
                            
                            <p>{{ "{:,}".format(cata.get('total_xp', 0)|int) }} XP</p>
                            
                            <p>Secrets Found: {{ skills.get('combat', {}).get('secrets_found', 0) }}</p>
                        </div>
                    </div>

                    <div id="debug" class="data-section" style="display: none;">
                        <h2>API Debug Info</h2>
                        <div class="stat-card">
                            <p><strong>Profile ID:</strong> {{ debug.active_profile_id }}</p>
                            <p><strong>Inventory API:</strong> {{ 'Enabled' if debug.inventory_api_enabled else 'DISABLED (Turn on in-game!)' }}</p>
                            <p><strong>Skills API:</strong> {{ 'Enabled' if debug.skills_api_enabled else 'DISABLED' }}</p>
                            <p><strong>Collection API:</strong> {{ 'Enabled' if debug.collection_api_enabled else 'DISABLED' }}</p>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="welcome-screen">
                <h1>SKYVIEWER</h1>
                <p>Search a player to begin</p>
            </div>
            {% endif %}
        </main>
    </div>

    <footer class="app-footer">
        <div class="footer-left">Switch player / profile</div>
        <div class="footer-right">Issues? <a href="https://github.com/k1ran654/Skyviewer/issues/new">create a ticket</a></div>
    </footer>

    <script src="{{ url_for('static', filename='scripts.js') }}"></script>
</body>
</html>